{
  "name": "@organon/core",
  "version": "0.4.1",
  "description": "The shared core of the saga's apps: the server without its routes, MCP and its bridge, control, release, .test and systemd, settings, storage, entities; design tokens, the look, the hover card.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "CHANGELOG.md"
  ],
  "exports": {
    "./server/settings": {
      "types": "./dist/server/settings.d.ts",
      "default": "./dist/server/settings.js"
    },
    "./server/store": {
      "types": "./dist/server/store.d.ts",
      "default": "./dist/server/store.js"
    },
    "./server/warnings": {
      "types": "./dist/server/warnings.d.ts",
      "default": "./dist/server/warnings.js"
    },
    "./shared/agents": {
      "types": "./dist/shared/agents.d.ts",
      "default": "./dist/shared/agents.js"
    },
    "./shared/accents": {
      "types": "./dist/shared/accents.d.ts",
      "default": "./dist/shared/accents.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./ui/theme": "./src/ui/theme.svelte.ts",
    "./ui/LookPicker.svelte": {
      "svelte": "./src/ui/LookPicker.svelte",
      "default": "./src/ui/LookPicker.svelte"
    },
    "./ui/tokens.css": "./src/ui/tokens.css",
    "./ui/theme-boot.js": "./src/ui/theme-boot.js",
    "./server/app": {
      "types": "./dist/server/app.d.ts",
      "default": "./dist/server/app.js"
    },
    "./server/http": {
      "types": "./dist/server/http.d.ts",
      "default": "./dist/server/http.js"
    },
    "./server/mcp": {
      "types": "./dist/server/mcp.d.ts",
      "default": "./dist/server/mcp.js"
    },
    "./server/bridge": {
      "types": "./dist/server/bridge.d.ts",
      "default": "./dist/server/bridge.js"
    },
    "./server/control": {
      "types": "./dist/server/control.d.ts",
      "default": "./dist/server/control.js"
    },
    "./server/release": {
      "types": "./dist/server/release.d.ts",
      "default": "./dist/server/release.js"
    },
    "./server/dev": {
      "types": "./dist/server/dev.d.ts",
      "default": "./dist/server/dev.js"
    },
    "./server/peer": {
      "types": "./dist/server/peer.d.ts",
      "default": "./dist/server/peer.js"
    },
    "./shared/entities": {
      "types": "./dist/shared/entities.d.ts",
      "default": "./dist/shared/entities.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./ui/HoverCard.svelte": {
      "svelte": "./src/ui/HoverCard.svelte",
      "default": "./src/ui/HoverCard.svelte"
    },
    "./scripts/*": "./scripts/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test 'tests/*.test.ts'",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "svelte": "^5.57.1",
    "vite": "^8.3.2"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  }
}
